{
  "fluid": true,
  "crons": [
    {
      "path": "/api/cron/billing",
      "schedule": "0 9,18 * * *"
    },
    {
      "path": "/api/cron/cleanup-stats-cache",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "0 10 */2 * *"
    },
    {
      "path": "/api/cron/health",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/calendar-reminders",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/mail-campaigns",
      "schedule": "*/1 * * * *"
    },
    {
      "path": "/api/cron/inr-agent",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/inr-agent-scheduled-actions",
      "schedule": "*/1 * * * *"
    },
    {
      "path": "/api/cron/inrsend-retention",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/mail-bounces",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/media-image-normalization",
      "schedule": "2-59/5 * * * *"
    },
    {
      "path": "/api/cron/media-video-normalization",
      "schedule": "*/1 * * * *"
    },
    {
      "path": "/api/cron/media-library-optimization",
      "schedule": "*/1 * * * *"
    },
    {
      "path": "/api/cron/media-orphan-cleanup",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/cron/booster-publications",
      "schedule": "*/1 * * * *"
    },
    {
      "path": "/api/cron/tiktok-publications",
      "schedule": "*/1 * * * *"
    }
  ],
  "functions": {
    "app/api/booster/video-transform/route.ts": {
      "includeFiles": "node_modules/ffmpeg-static/**/*"
    },
    "app/api/booster/publish-now/route.ts": {
      "includeFiles": "node_modules/ffmpeg-static/**/*"
    },
    "app/api/inrsend/publications/[publicationId]/pinterest/route.ts": {
      "includeFiles": "node_modules/ffmpeg-static/**/*"
    },
    "app/api/cron/media-video-normalization/route.ts": {
      "includeFiles": "node_modules/ffmpeg-static/**/*"
    },
    "app/api/cron/media-library-optimization/route.ts": {
      "includeFiles": "node_modules/ffmpeg-static/**/*"
    },
    "app/api/media-library/optimization/run/route.ts": {
      "includeFiles": "node_modules/ffmpeg-static/**/*"
    },
    "app/api/media-pipeline/workspace/prepare/route.ts": {
      "includeFiles": "node_modules/ffmpeg-static/**/*"
    },
    "app/api/media-pipeline/workspace/prewarm/route.ts": {
      "includeFiles": "node_modules/ffmpeg-static/**/*"
    },
    "app/api/media-pipeline/upload-event/route.ts": {
      "includeFiles": "node_modules/ffmpeg-static/**/*"
    },
    "app/api/media-generation/generate/route.ts": {
      "includeFiles": "{node_modules/ffmpeg-static/**/*,assets/media-generation/soundtracks/**/*}"
    }
  }
}
