import assert from "node:assert/strict";
import test from "node:test";
import { persistStudioVideoRetouch } from "../../lib/studioVideoRetouchPersistence.ts";
import type { BoosterVideoTransformedVariant } from "../../lib/boosterVideoTransforms.ts";

const sourceId = "11111111-1111-4111-8111-111111111111";
const outputId = "22222222-2222-4222-8222-222222222222";
const variant: BoosterVideoTransformedVariant = { key: "portrait", channel: "site_web", format: "9_16", adaptationMode: "cover_crop",
  signature: "portrait-crop", target: { format: "9_16", width: 720, height: 1280, aspectRatio: "9:16", label: "Portrait" },
  storagePath: "owned/generated.mp4", publicUrl: "https://storage.example.test/generated.mp4", contentType: "video/mp4", size: 4,
  duration: 12, generatedAt: "2026-11-02T12:00:00Z" };
function setup() {
  let current = true;
  let metadata: Record<string, unknown> = {};
  const calls: string[] = [];
  const options = { sourceName: "original.mov", sourceMediaId: sourceId, channel: "site_web", format: "9_16", adaptationMode: "cover_crop", variants: [variant], isCurrent: () => current };
  const ports = {
    fetch: (async (input: string | URL | Request) => {
      const url = String(input); calls.push(url);
      if (url === variant.publicUrl) return new Response(new Uint8Array([1, 2, 3, 4]), { headers: { "Content-Type": "video/mp4" } });
      assert.equal(url, `/api/media-library/items?id=${outputId}`);
      return Response.json({ items: [{ id: outputId, media_type: "video", size_bytes: 4, media_metadata: metadata }] });
    }) as typeof fetch,
    upload: async (file: File, input: { metadata: Record<string, unknown> }) => {
      calls.push("upload"); metadata = input.metadata;
      assert.equal(file.name, "original-retouche-9_16.mp4");
      assert.equal(file.type, "video/mp4");
      assert.deepEqual([...new Uint8Array(await file.arrayBuffer())], [1, 2, 3, 4]);
      return { id: outputId };
    },
  };
  return { options, ports, calls, invalidate: () => { current = false; } };
}

test("saves the actual generated bytes as a new owned item and verifies its format, preserving the original", async () => {
  const fixture = setup();
  const result = await persistStudioVideoRetouch(fixture.options, fixture.ports);
  assert.equal(result.id, outputId);
  assert.deepEqual(fixture.calls, [variant.publicUrl, "upload", `/api/media-library/items?id=${outputId}`]);
  assert.equal(fixture.options.sourceMediaId, sourceId);
});

for (const change of [{ variants: [] }, { format: "1_1" }, { adaptationMode: "safe_frame" }, { channel: "facebook" }]) {
  test(`rejects absent or mismatching transformed variant: ${JSON.stringify(change)}`, async () => {
    const fixture = setup();
    await assert.rejects(persistStudioVideoRetouch({ ...fixture.options, ...change }, fixture.ports), /Aucune variante/);
    assert.deepEqual(fixture.calls, []);
  });
}

test("does not upload a missing, wrong-sized or non-video output", async () => {
  for (const response of [new Response(null, { status: 404 }), new Response("short", { headers: { "Content-Type": "video/mp4" } }), new Response("1234", { headers: { "Content-Type": "text/html" } })]) {
    const fixture = setup(); fixture.ports.fetch = async () => response;
    await assert.rejects(persistStudioVideoRetouch(fixture.options, fixture.ports));
    assert.deepEqual(fixture.calls, []);
  }
});

test("cannot report save success from an upload without the exact owned read-back", async () => {
  for (const item of [null, { id: outputId, media_type: "image", size_bytes: 4 }, { id: sourceId, media_type: "video", size_bytes: 4 }, { id: outputId, media_type: "video", size_bytes: 4, media_metadata: { format: "1_1" } }]) {
    const fixture = setup(), read = fixture.ports.fetch;
    fixture.ports.fetch = async (url, init) => String(url).startsWith("/api/") ? Response.json({ items: [item].filter(Boolean) }) : read(url, init);
    await assert.rejects(persistStudioVideoRetouch(fixture.options, fixture.ports), /présence exacte/);
  }
});

test("an upload response naming the original is never accepted as a new copy", async () => {
  const fixture = setup(); fixture.ports.upload = async () => ({ id: sourceId });
  await assert.rejects(persistStudioVideoRetouch(fixture.options, fixture.ports), /nouvelle copie/);
  assert.deepEqual(fixture.calls, [variant.publicUrl]);
});

for (const stage of ["before", "download", "upload", "readback"]) {
  test(`source/account invalidation at ${stage} prevents a successful continuation`, async () => {
    const fixture = setup(), fetch = fixture.ports.fetch, upload = fixture.ports.upload;
    if (stage === "before") fixture.invalidate();
    fixture.ports.fetch = async (url, init) => {
      const response = await fetch(url, init);
      if (stage === "download" && String(url) === variant.publicUrl || stage === "readback" && String(url).startsWith("/api/")) fixture.invalidate();
      return response;
    };
    fixture.ports.upload = async (file, options) => { const result = await upload(file, options); if (stage === "upload") fixture.invalidate(); return result; };
    await assert.rejects(persistStudioVideoRetouch(fixture.options, fixture.ports), /compte a changé/);
    if (stage === "before" || stage === "download") assert.ok(!fixture.calls.includes("upload"));
    if (stage === "upload") assert.ok(!fixture.calls.some(value => value.startsWith("/api/")));
  });
}
